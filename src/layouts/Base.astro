---
import '../styles/main.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import CookieLista from '../components/CookieLista.astro';
import { SITE_NAME, SITE_TAGLINE, SITE_URL, PRICE_START, META_PIXEL_ID, CONSENT_API_URL, VIDEO_REFERENCE } from '../config.mjs';
import { kanonickaUrl } from '../lib/kanonicka.mjs';

interface Props {
	// vlastní titulek stránky celý, bez oddělovačů (jinak název a tagline)
	titulek?: string;
	// stránka mimo vyhledávače (404): noindex a bez canonical
	noindex?: boolean;
}

const { titulek, noindex = false } = Astro.props;
const title = titulek ?? `${SITE_NAME}, ${SITE_TAGLINE}`;
// stránky jsou statické, Astro.url.pathname je cesta z buildu, nikdy s query
const canonical = kanonickaUrl(Astro.url.pathname);
const description = `Polapeno zvedne telefon, když nemůžete. Telefonní asistent pro autoservisy od ${PRICE_START} Kč měsíčně.`;
---

<!doctype html>
<html lang="cs">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<title>{title}</title>
		<meta name="description" content={description} />
		{noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={noindex ? SITE_URL + '/' : canonical} />
		<meta property="og:type" content="website" />
		<meta property="og:image" content={`${SITE_URL}/img/og-image.jpg`} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		{/* oba soubory Rubiku hned na začátku, ať se vymění v jednom kroku
		    (jinak mezi ně vklíní písmo poznámky u videa a text hera poskočí dvakrát) */}
		<link rel="preload" as="font" type="font/woff2" href="/fonts/rubik-latin.woff2" crossorigin />
		<link rel="preload" as="font" type="font/woff2" href="/fonts/rubik-latin-ext.woff2" crossorigin />
		{/* náhled video reference je v heru úvodní stránky (na mobilu hned pod ním) a bývá LCP prvkem */}
		{VIDEO_REFERENCE && Astro.url.pathname === '/' && <link rel="preload" as="image" href="/video/ander-poster.webp" type="image/webp" fetchpriority="high" />}
		<script src="/main.js" defer></script>
	</head>
	<body data-pixel={META_PIXEL_ID} data-consent-api={CONSENT_API_URL}>
		<Nav />
		<main>
			<slot />
		</main>
		<Footer />
		<CookieLista />
	</body>
</html>
