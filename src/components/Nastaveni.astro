---
import Kresba from './Kresba.astro';
---

<section id="nastaveni" class="section section--dark nastaveni">
	<h2>
		<span class="nastaveni-hlavni">Za 10 minut už za vás zvedá hovory.</span>
		<span class="nastaveni-pod">Asistenta si nastavíte přes naši webovou aplikaci.</span>
	</h2>

	<div class="nastaveni-obsah">
		<!-- roadmapa: pořadí nese čára zleva doprava (na mobilu shora dolů), žádná čísla.
		     Texty s ilustrací střídavě nad a pod čárou. -->
		<div class="roadmap">
			<Kresba typ="cesta" seed={11} staticka />
			<Kresba typ="cesta-svisla" seed={12} staticka />
			<ol class="roadmap-zastavky">
				<li class="zastavka zastavka--nahore">
					<Kresba typ="tecka" seed={21} staticka />
					<div class="zastavka-text">
						<img
							class="roadmap-ilust"
							src="/img/roadmap-1.jpg"
							width="200"
							height="200"
							alt="Registrace v portálu"
							loading="lazy"
							decoding="async"
						/>
						<div>
							<h3>Založíte si účet</h3>
							<p>Jméno servisu, otevírací dobu a co děláte. Dvě minuty.</p>
						</div>
					</div>
				</li>
				<li class="zastavka zastavka--dole">
					<Kresba typ="tecka" seed={22} staticka />
					<div class="zastavka-text">
						<img
							class="roadmap-ilust"
							src="/img/roadmap-2.jpg"
							width="200"
							height="200"
							alt="Nastavení asistenta"
							loading="lazy"
							decoding="async"
						/>
						<div>
							<h3>Nastavíte asistenta</h3>
							<p>Řeknete mu, jak se má hlásit a co má zjistit. Vyplníte formulář, žádný technik.</p>
						</div>
					</div>
				</li>
				<li class="zastavka zastavka--nahore">
					<Kresba typ="tecka" seed={23} staticka />
					<div class="zastavka-text">
						<img
							class="roadmap-ilust"
							src="/img/roadmap-3.jpg"
							width="200"
							height="200"
							alt="Zapnutí přesměrování"
							loading="lazy"
							decoding="async"
						/>
						<div>
							<h3>Zapnete přesměrování</h3>
							<p>Na svém telefonu jedno nastavení. Hotovo.</p>
						</div>
					</div>
				</li>
			</ol>
			<Kresba typ="fajfka" seed={31} staticka />
		</div>

		<div class="portal">
			<img
				class="portal-monitor"
				src="/img/device-desktop.jpg"
				width="1000"
				height="848"
				alt="Portál Polapeno — přehled hovorů"
				loading="lazy"
				decoding="async"
			/>
			<img
				class="portal-telefon"
				src="/img/device-mobile.jpg"
				width="419"
				height="780"
				alt="Portál Polapeno na mobilu"
				loading="lazy"
				decoding="async"
			/>
		</div>
	</div>
</section>
