---
import {
	SITE_TAGLINE,
	PRICE_START,
	DEMO_READY,
	DEMO_NUMBER,
	PORTAL_URL,
	CTA_PRIMARY,
	CTA_SECONDARY,
} from '../config.mjs';

const demoTel = `tel:${DEMO_NUMBER.replace(/\s+/g, '')}`;
---

<section id="hero" class="section section--dark hero">
	<svg class="hero-sketch" viewBox="0 0 400 480" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M8 393Q14 361 39 357Q63 352 87 333Q111 314 158 311Q206 308 236 328Q266 347 301 353Q336 359 343 375L350 392" stroke-width="1.2"/><path d="M8 394Q27 395 27 395Q27 395 35 397L44 398" stroke-width="1.2"/><path d="M112 398Q176 399 176 399Q176 399 208 399L240 398" stroke-width="2.5"/><path d="M312 398Q331 395 331 395Q331 395 342 394L352 393" stroke-width="1.9"/><path d="M40 399Q42 384 47 378Q52 372 58 368Q64 364 72 362Q79 360 86 362Q94 363 100 367Q106 372 111 378Q116 383 117 391L118 399" stroke-width="2.4"/><path d="M236 399Q238 384 243 378Q248 372 254 368Q260 363 268 361Q275 360 283 361Q290 363 296 367Q303 371 307 378Q311 384 313 391L315 399" stroke-width="2.3"/><path d="M106 411Q99 422 93 425Q87 429 80 430Q74 430 68 427Q61 424 58 419Q54 413 52 407Q50 401 52 394Q54 388 59 383Q63 378 69 376Q76 373 82 374Q89 375 94 378Q100 382 103 388Q107 394 107 400Q106 407 104 413L102 420" stroke-width="2.3"/><path d="M248 413Q246 399 249 393Q251 386 256 382Q260 377 267 375Q273 373 280 374Q287 375 292 379Q298 383 300 389Q303 395 303 402Q303 409 300 414Q296 420 291 424Q286 428 279 429Q272 430 266 427Q260 425 255 420Q251 415 248 409L246 403" stroke-width="1.5"/><path d="M84 394Q87 397 87 399Q88 401 87 403Q87 405 86 407Q85 408 83 409Q81 410 79 410Q77 410 75 409Q73 408 72 406Q70 405 70 403Q70 400 71 398Q71 396 73 395Q74 393 76 393Q79 393 81 393Q83 393 84 394L86 396" stroke-width="1.6"/><path d="M281 394Q284 397 284 399Q284 401 284 404Q283 406 282 407Q280 409 278 409Q276 410 274 410Q272 410 271 409Q269 408 268 406Q266 404 266 402Q266 400 267 398Q268 396 270 394Q271 393 273 393Q276 392 278 393Q280 394 281 395L283 396" stroke-width="2.1"/><path d="M90 349Q123 320 157 318Q192 317 212 333Q232 350 162 350L92 351" stroke-width="2.7"/><path d="M160 320Q160 335 160 335Q160 335 161 343L161 351" stroke-width="1.9"/><path d="M228 39Q284 41 288 46Q292 50 293 114Q293 179 289 182Q284 186 256 187Q228 187 223 183Q219 179 221 113Q222 48 227 45L231 42" stroke-width="1.6"/><path d="M249 172Q257 171 257 171Q257 171 261 171L266 171" stroke-width="1.9"/><path d="M310 85Q315 96 316 102Q316 108 316 114Q315 119 314 125Q314 131 312 137L310 143" stroke-width="1.7"/><path d="M330 78Q334 92 336 99Q338 106 338 114Q338 121 336 128Q334 135 332 142L330 149" stroke-width="1.9"/><path d="M205 142Q201 131 199 125Q198 120 197 113Q196 107 197 101Q198 95 201 90L204 85" stroke-width="1.9"/></svg>
	<p class="eyebrow">{SITE_TAGLINE}</p>
	<h1>Kolik zakázek vám letos uteklo, protože jste byl pod autem?</h1>
	<p class="hero-claim">Od {PRICE_START} Kč měsíčně. Číslo si necháváte svoje.</p>

	<ol class="flow">
		<li><span class="flow-num" aria-hidden="true">1</span> Zákazník volá</li>
		<li><span class="flow-num" aria-hidden="true">2</span> Asistent zvedne</li>
		<li><span class="flow-num" aria-hidden="true">3</span> Zápis v portálu</li>
	</ol>

	<div class="hero-cta">
		{DEMO_READY ? (
			<>
				<div class="hero-demo">
					<a class="btn btn--primary" href={demoTel}>{CTA_PRIMARY}</a>
					<a class="hero-demo-number" href={demoTel}>{DEMO_NUMBER}</a>
				</div>
				<a class="btn btn--secondary" href={PORTAL_URL}>{CTA_SECONDARY}</a>
			</>
		) : (
			<a class="btn btn--primary" href={PORTAL_URL}>{CTA_SECONDARY}</a>
		)}
	</div>

	<p class="note">Bez zadání karty.</p>
</section>
