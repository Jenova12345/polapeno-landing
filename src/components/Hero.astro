---
import {
	SITE_TAGLINE,
	PRICE_START,
	DEMO_READY,
	DEMO_NUMBER,
	PORTAL_URL,
	CTA_PRIMARY,
	CTA_SECONDARY,
} from '../config.mjs';
import Kresba from './Kresba.astro';

const demoTel = `tel:${DEMO_NUMBER.replace(/\s+/g, '')}`;
---

<section id="hero" class="section section--dark hero">
	<p class="eyebrow">{SITE_TAGLINE}</p>
	<h1>
		<span class="hero-otazka">Kolik zakázek vám letos uteklo?</span>
		<span class="hero-duvod">Protože jste zrovna zaneprázdnění.</span>
	</h1>
	<p class="hero-claim">Od {PRICE_START} Kč měsíčně. Číslo si necháváte svoje.</p>

	<ol class="flow">
		<li><span class="flow-num" aria-hidden="true">1</span> Zákazník volá<Kresba typ="sipka" seed={11} /></li>
		<li><span class="flow-num" aria-hidden="true">2</span> Asistent zvedne<Kresba typ="sipka" seed={23} /></li>
		<li><span class="flow-num" aria-hidden="true">3</span> Zápis v portálu</li>
	</ol>

	<div class="hero-cta">
		{DEMO_READY ? (
			<>
				<div class="hero-demo">
					<a class="btn btn--primary" href={demoTel}>{CTA_PRIMARY}</a>
					<a class="hero-demo-number" href={demoTel}>{DEMO_NUMBER}</a>
				</div>
				<a class="btn btn--secondary" href={PORTAL_URL}>{CTA_SECONDARY}</a>
			</>
		) : (
			<a class="btn btn--primary" href={PORTAL_URL}>{CTA_SECONDARY}</a>
		)}
	</div>

	<p class="note">Bez zadání karty.</p>
</section>
