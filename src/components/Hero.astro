---
import {
	PRICE_START,
	DEMO_READY,
	DEMO_NUMBER,
	PORTAL_URL,
	CTA_PRIMARY,
	CTA_SECONDARY,
	TRIAL_DAYS,
} from '../config.mjs';

const demoTel = `tel:${DEMO_NUMBER.replace(/\s+/g, '')}`;
---

<section id="hero" class="section section--dark hero">
	<h1>
		<span class="hero-problem">Zmeškané hovory vás stojí zakázky.</span>
		<span class="hero-reseni">Polapeno je zvedne za vás.</span>
	</h1>
	<p class="hero-claim">Od {PRICE_START} Kč měsíčně. Číslo si necháváte. Bez smlouvy.</p>

	<div class="hero-cta">
		{DEMO_READY ? (
			<>
				<div class="hero-demo">
					<a class="btn btn--primary" href={demoTel}>{CTA_PRIMARY}</a>
					<a class="hero-demo-number" href={demoTel}>{DEMO_NUMBER}</a>
				</div>
				<a class="btn btn--secondary" href={PORTAL_URL}>{CTA_SECONDARY}</a>
			</>
		) : (
			<a class="btn btn--primary" href={PORTAL_URL}>{CTA_SECONDARY}</a>
		)}
	</div>

	<p class="note">{TRIAL_DAYS} dní zdarma. Bez zadání karty.</p>
</section>
